#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Japanese {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <16 17>;
            layers = <0>;
        };

        English {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <13 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q             &kp W         &kp E              &kp R    &kp T                                          &kp Y        &kp U  &kp I      &kp O       &lt 6 P
&kp A             &kp S         &lt 6 D            &lt 5 F  &kp G                                          &kp H        &kp J  &kp K      &kp L       &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C              &kp V    &kp B                                          &kp N        &kp M  &kp COMMA  &kp DOT     &mt RIGHT_SHIFT SLASH
&kp LEFT_GUI      &kp LEFT_ALT  &lt 4 PRINTSCREEN  &none    &mt LCTRL SPACE  &lt 2 TAB    &lt 1 BACKSPACE  &lt 3 ENTER  &none  &to 5      &kp ESCAPE  &kp DELETE
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            display-name = "Number Layer";
            bindings = <
&none  &kp F7  &kp F8  &kp F9  &kp F12                  &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS
&none  &kp F4  &kp F5  &kp F6  &kp F11                  &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&none  &kp F1  &kp F2  &kp F3  &kp F10                  &kp NUMBER_0  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&none  &none   &none   &none   &none    &none    &none  &none         &none         &none         &none         &none
            >;
        };

        layer_2 {
            display-name = "Mark Layer";
            bindings = <
&none  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET      &kp SEMICOLON         &kp COLON
&none  &kp PERCENT      &kp DLLR      &kp CARET             &none                                  &kp TILDE  &kp LPAR          &kp RIGHT_PARENTHESIS  &kp APOSTROPHE        &kp DOUBLE_QUOTES
&none  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &none                                  &kp PIPE   &kp LEFT_BRACE    &kp RIGHT_BRACE        &kp NON_US_BACKSLASH  &kp PIPE
&none  &none            &none         &none                 &none                  &none    &none  &none      &none             &none                  &none                 &none
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Arrow Layer";
            bindings = <
&none   &none  &none  &none  &none                  &kp LC(V)  &kp HOME        &kp UP_ARROW    &kp END          &none
&emoji  &none  &none  &none  &none                  &kp LC(C)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT
&none   &none  &none  &none  &none                  &kp LC(X)  &none           &none           &none            &none
&none   &none  &none  &none  &none  &none    &none  &none      &none           &none           &none            &none
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&studio_unlock  &none           &none  &none  &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none           &none           &none  &none  &none                                &none         &none         &none         &none         &none
&sys_reset      &none           &none  &none  &none                                &none         &none         &none         &none         &sys_reset
&bootloader     &bt BT_CLR_ALL  &none  &none  &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
            >;
        };

        layer_5 {
            display-name = "Mouse Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LC(V)  &mkp MCLK           &mkp MCLK            &trans              &mo 6
&trans  &trans  &trans  &trans  &trans                    &kp LC(C)  &mkp LCLK           &mkp RCLK            &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)
&trans  &trans  &trans  &trans  &trans                    &kp LC(X)  &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans              &to 0                &trans              &trans
            >;
        };

        layer_6 {
            display-name = "Scroll Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &msc SCRL_UP    &trans           &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &trans          &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans           &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
